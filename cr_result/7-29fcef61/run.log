          def _calculate_window_size(self, lines: List[str], start_idx: int) -> Tuple[int, int]:
              """计算当前窗口的结束位置和字符数"""
              end_idx = start_idx
              char_count = 0
              while end_idx < len(lines) and char_count < self.chunk_size:
                  char_count += len(lines[end_idx]) + 1
                  end_idx += 1
              return end_idx, char_count

          def _create_chunk(self, file_path: str, lines: List[str], start_idx: int, end_idx: int, chunk_id: int) -> CodeChunk:
              """创建单个代码块"""
              chunk_lines = lines[start_idx:end_idx]
              chunk_content = "\n".join(chunk_lines)
