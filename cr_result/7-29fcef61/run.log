          from packaging import version

          def _check_python_version(py_cmd: str) -> bool:
              """检查Python版本是否>=3.12"""
              try:
                  result = subprocess.run(
                      [py_cmd, "-c", "import sys; print(sys.version)"],
                      capture_output=True,
                      text=True,
                      timeout=5
                  )
                  if result.returncode == 0:
                      v = version.parse(result.stdout.split()[0])
                      return v >= version.parse("3.12")
              except Exception:
                  return False
              return False

          def _find_python_executable() -> Optional[str]:
              """查找符合版本要求的Python可执行文件"""
              candidates = ["python3.12", "python3.13", "python3", "python"]
              pyenv_path = Path.home() / ".pyenv" / "versions"
              
              if pyenv_path.exists():
                  for ver_dir in sorted(pyenv_path.glob("3.1*"), reverse=True):
                      py_bin = ver_dir / "bin" / "python3"
                      if py_bin.exists():
                          candidates.insert(0, str(py_bin))
              
              for cmd in candidates:
