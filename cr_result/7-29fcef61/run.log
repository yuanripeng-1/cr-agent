              lines = content.splitlines()
              if not lines:
                  return []

              chunks = []
              chunk_id = 0
              start_idx = 0

              while start_idx < len(lines):
                  end_idx, _ = self._calculate_window_size(lines, start_idx)
                  end_idx = max(end_idx, start_idx + 1)  # 确保至少一行

                  chunks.append(self._create_chunk(file_path, lines, start_idx, end_idx, chunk_id))
                  chunk_id += 1

                  if chunk_id >= self.max_chunks_per_file:
                      break

                  start_idx = self._calculate_next_start(start_idx, end_idx)
                  if start_idx >= end_idx:  # 避免死循环
                      start_idx = end_idx

              return chunks
