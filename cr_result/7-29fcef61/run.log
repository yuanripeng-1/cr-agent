              )

          def _calculate_next_start(self, current_start: int, current_end: int) -> int:
              """计算下一个窗口的起始位置"""
              overlap_lines = max(1, self.chunk_overlap // 80)
              return max(current_start + 1, current_end - overlap_lines)

          def _chunk_by_sliding_window(self, file_path: str, content: str) -> List[CodeChunk]:
