                  ))
                  
                  chunk_id += 1
                  
                  # 检查是否达到最大块数
                  if chunk_id >= self.max_chunks_per_file:
                      break
                  
                  # 计算下一个窗口的起始位置（考虑重叠）
                  overlap_lines = max(1, self.chunk_overlap // 80)
                  start_line_idx = max(start_line_idx + 1, end_line_idx - overlap_lines)
                  
                  # 如果没有前进，强制前进避免死循环
                  if start_line_idx >= end_line_idx:
                      start_line_idx = end_line_idx
              
              return chunks
        improved_code: |
          def _calculate_window(self, lines: List[str], start_idx: int) -> Tuple[int, int]:
              """计算当前窗口的结束位置和字符数"""
              end_idx = start_idx
              char_count = 0
              
              while end_idx < len(lines) and char_count < self.chunk_size:
                  char_count += len(lines[end_idx]) + 1
                  end_idx += 1
              
              return end_idx, char_count

          def _create_chunk(self, file_path: str, lines: List[str], 
                          start_idx: int, end_idx: int, chunk_id: int) -> CodeChunk:
              """创建单个代码块"""
              chunk_lines = lines[start_idx:end_idx]
              chunk_content = "\n".join(chunk_lines)
              
              return CodeChunk(
                  chunk_id=f"{file_path}::{chunk_id}",
                  file_path=file_path,
                  start_line=start_idx + 1,
                  end_line=end_idx,
                  content=chunk_content,
                  language=self._detect_language(file_path),
                  chunk_type="block",
                  char_count=len(chunk_content),
                  line_count=len(chunk_lines)
              )

          def _chunk_by_sliding_window(self, file_path: str, content: str) -> List[CodeChunk]:
              lines = content.splitlines()
