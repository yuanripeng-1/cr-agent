          lines = content.splitlines()
          chunks = []
          
          if not lines:
              return chunks
              
          chunk_id = 0
          start_line_idx = 0
          
          while start_line_idx < len(lines):
              # 计算当前窗口
              end_line_idx = start_line_idx
              char_count = 0
              
              # 向后扩展，直到超过 chunk_size
              while end_line_idx < len(lines) and char_count < self.chunk_size:
                  char_count += len(lines[end_line_idx]) + 1  # +1 for newline
                  end_line_idx += 1
        improved_code: |
          # 使用生成器逐行处理
          def iter_lines(content):
              start = 0
              while True:
                  end = content.find('\n', start)
                  if end == -1:
                      yield content[start:]
                      break
                  yield content[start:end]
                  start = end + 1
                  
          # 使用更高效的切块算法
          chunks = []
          current_chunk = []
          current_size = 0
          
          for line in iter_lines(content):
              line_len = len(line) + 1  # +1 for newline
              if current_size + line_len > self.chunk_size and current_chunk:
                  chunks.append(CodeChunk(...))
                  # 保留重叠部分
                  current_chunk = current_chunk[-self.chunk_overlap//80:]
