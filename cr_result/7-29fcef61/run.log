      code_suggestion: |
        def _chunk_by_sliding_window(self, file_path: str, content: str) -> List[CodeChunk]:
            lines = content.splitlines()
            if not lines:
                return []
            
            chunks = []
            chunk_id = 0
            start_line_idx = 0
            
            while start_line_idx < len(lines):
                end_line_idx, char_count = self._calculate_window_size(lines, start_line_idx)
                chunk_content = self._extract_chunk_content(lines, start_line_idx, end_line_idx)
                chunks.append(self._create_chunk_object(file_path, chunk_id, start_line_idx, end_line_idx, chunk_content))
                
                chunk_id += 1
                if chunk_id >= self.max_chunks_per_file:
                    break
                    
                start_line_idx = self._calculate_next_start_position(end_line_idx)
                
            return chunks
