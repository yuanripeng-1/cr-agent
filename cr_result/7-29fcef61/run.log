              chunks = []
              chunk_id = 0
              start_idx = 0
              
              while start_idx < len(lines) and chunk_id < self.max_chunks_per_file:
                  end_idx, _ = self._calculate_window(lines, start_idx)
                  chunks.append(self._create_chunk(file_path, lines, start_idx, end_idx, chunk_id))
