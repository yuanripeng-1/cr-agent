              calc := NewAdvancedCalculator()
              _, err := calc.Factorial(-5)
              if err == nil {
                  t.Error("Expected error when calculating factorial of negative number")
              }
          }

          func TestFactorialTooLarge(t *testing.T) {
              calc := NewAdvancedCalculator()
              _, err := calc.Factorial(21)
              if err == nil {
                  t.Error("Expected error when calculating factorial of number larger than 20")
              }
          }
