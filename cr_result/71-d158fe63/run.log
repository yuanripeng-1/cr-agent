      end_line: 84
      severity: |
        HIGH
      description: |
        阶乘计算使用循环实现，对于大数(接近20)会有重复计算，且没有缓存机制。
      requirement_reference: |
        无明确性能要求，但数学运算应考虑优化
      code_suggestion:
        existing_code: |
          func (ac *AdvancedCalculator) Factorial(n int) (int, error) {
              if n < 0 {
                  return 0, errors.New("不能计算负数的阶乘")
              }
              if n > 20 {
                  return 0, errors.New("数值过大，阶乘结果超出int范围")
              }
              
              result := 1
              for i := 2; i <= n; i++ {
                  result *= i
              }
              ac.addToHistory(fmt.Sprintf("%d! = %d", n, result))
              return result, nil
          }
        improved_code: |
          var factorialCache = map[int]int{0: 1, 1: 1} // 预缓存基础值

          func (ac *AdvancedCalculator) Factorial(n int) (int, error) {
              if n < 0 {
                  return 0, errors.New("不能计算负数的阶乘")
              }
              if n > 20 {
                  return 0, errors.New("数值过大，阶乘结果超出int范围")
              }
              
              if val, exists := factorialCache[n]; exists {
                  return val, nil
              }
              
              result := 1
              for i := 2; i <= n; i++ {
                  result *= i
                  factorialCache[i] = result // 缓存计算结果
              }
              ac.addToHistory(fmt.Sprintf("%d! = %d", n, result))
              return result, nil
          }
      confidence: 85
