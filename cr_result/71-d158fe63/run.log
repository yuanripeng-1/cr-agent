          var factorialCache = []int{1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880, 3628800}

          func (ac *AdvancedCalculator) Factorial(n int) (int, error) {
              if n < 0 {
                  return 0, errors.New("不能计算负数的阶乘")
              }
              if n > 20 {
                  return 0, errors.New("数值过大，阶乘结果超出int范围")
              }
              
              if n < len(factorialCache) {
                  return factorialCache[n], nil
              }
              
              result := factorialCache[len(factorialCache)-1]
              for i := len(factorialCache); i <= n; i++ {
                  result *= i
                  factorialCache = append(factorialCache, result)
              }
              ac.addToHistory(fmt.Sprintf("%d! = %d", n, result))
              return result, nil
          }
