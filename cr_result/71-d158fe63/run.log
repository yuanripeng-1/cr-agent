      description: |
        `addToHistory`方法中直接使用`append`来添加历史记录，这会导致内存分配和复制操作频繁发生，特别是在历史记录较多时，性能会显著下降。
      requirement_reference: |
        无明确性能要求，但频繁的内存分配和复制会影响系统性能。
      code_suggestion:
        existing_code: |
          func (ac *AdvancedCalculator) addToHistory(record string) {
            ac.history = append(ac.history, record)
          }
        improved_code: |
          func (ac *AdvancedCalculator) addToHistory(record string) {
            if cap(ac.history) > len(ac.history) {
              ac.history = append(ac.history, record)
            } else {
              newHistory := make([]string, len(ac.history), len(ac.history)*2)
              copy(newHistory, ac.history)
              ac.history = append(newHistory, record)
            }
          }
