              return result, nil
          }
        improved_code: |
          func (ac *AdvancedCalculator) Factorial(n int) (int, error) {
              if n < 0 {
                  return 0, errors.New("不能计算负数的阶乘")
              }
              if n > 20 {
                  return 0, errors.New("数值过大，阶乘结果超出int范围")
              }
              
              // 使用预计算的阶乘表
              factorials := []int{1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880, 3628800}
              if n <= 10 {
                  return factorials[n], nil
              }
              
              result := factorials[10]
              for i := 11; i <= n; i++ {
                  result *= i
              }
              ac.addToHistory(fmt.Sprintf("%d! = %d", n, result))
