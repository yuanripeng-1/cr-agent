diff --git a/gui/src/components/mainInput/TipTapEditor/hooks/useNodeViewEditorContext.ts b/gui/src/components/mainInput/TipTapEditor/hooks/useNodeViewEditorContext.ts
new file mode
@@ -0,0 +1,49 @@
+import { Editor } from "@tiptap/react";
+import { useCallback } from "react";
+
+/**
+ * 提取 NodeView 共享的编辑器上下文信息
+ * 用于判断是否显示关闭按钮等 UI 行为
+ */
+export function useNodeViewEditorContext(editor: Editor | null) {
+  const isEditable = editor?.isEditable ?? false;
+  const isMainInput =
+    editor?.view?.dom?.getAttribute?.("data-testid") === "editor-input-main";
+
+  return {
+    isEditable,
+    isMainInput,
+    showCloseButton: isMainInput && isEditable,
+  };
+}
+
+/**
+ * 点击 tag 非交互区域时定位光标
+ * 根据点击位置决定光标放在节点前还是节点后
+ */
+export function useCapsuleAreaClick(
+  editor: Editor | null,
+  getPos: (() => number) | undefined
+) {
+  return useCallback(
+    (e: React.MouseEvent) => {
+      if (!editor || !getPos) return;
+
+      const target = e.target as Element;
+      const capsule = target.closest(".code-block-capsule");
+
+      const pos = getPos();
+      if (capsule) {
+        const rect = capsule.getBoundingClientRect();
+        const clickX = e.clientX;
+        const capsuleMidX = rect.left + rect.width / 2;
+        editor.commands.setTextSelection(clickX < capsuleMidX ? pos : pos + 1);
+      } else {
+        editor.commands.setTextSelection(pos + 1);
+      }
+      editor.commands.focus();
+      e.stopPropagation();
+    },
+    [editor, getPos]
+  );
+}
